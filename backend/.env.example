# Django Backend Environment Configuration
SECRET_KEY=change-me-to-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,.onrender.com,.railway.app

# CORS Allowed Origins (Comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# API Rate Limiting
RATE_LIMIT=40/minute

# Storage & Timeouts (10 GB max, 1 hour timeout)
MAX_DOWNLOAD_SIZE_MB=10240
DOWNLOAD_TIMEOUT=3600
